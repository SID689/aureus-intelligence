# Secrets — never commit real credentials
.env
.env.*
!.env.example
!.env.*.example

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Node / Next.js
node_modules/
.next/
out/

# Celery
celerybeat-schedule
celerybeat.pid

# OS
.DS_Store

# Editors
.vscode/
.idea/

# TypeScript incremental build cache
*.tsbuildinfo

# Finder and editor duplicates. "env.example copy" has no leading dot, so
# every .env* rule above missed it, and a real Stripe key reached the
# history inside one. Match the shape, not the prefix.
* copy
* copy.*
*\ copy
*.orig
*.bak

# Local deployment worksheet with generated secrets. Never committed.
.deploy/
market_data*.sql
