# Secrets — never commit real credentials
.env
.env.*
!.env.example
!.env.*.example

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Node / Next.js
node_modules/
.next/
out/

# Celery
celerybeat-schedule
celerybeat.pid

# OS
.DS_Store

# Editors
.vscode/
.idea/

# TypeScript incremental build cache
*.tsbuildinfo

# Exported market data for a cloud demo, regenerated by
# scripts/export_showcase_data.sh. Several MB of rows, not source.
showcase_data*.sql

# Deployment worksheet with generated secrets, written by the assistant for
# a one-off demo deployment. Local only.
.demo-deploy/

# Finder and editor duplicates. "env.example copy" has no leading dot, so
# every .env* rule above missed it, and a real Stripe key reached the
# history inside one. Match the shape, not the prefix.
* copy
* copy.*
*\ copy
*.orig
*.bak
