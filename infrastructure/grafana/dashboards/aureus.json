{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Aureus Intelligence — API latency, LLM costs, execution errors, WebSocket connections",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "id": 1,
      "title": "API Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(aureus_analysis_requests_total[5m])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "reqps"
        }
      },
      "options": { "tooltip": { "mode": "multi" } }
    },

    {
      "id": 2,
      "title": "Analysis Latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(aureus_analysis_duration_seconds_bucket[5m])) by (le, horizon))",
          "legendFormat": "p50 {{horizon}}", "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(aureus_analysis_duration_seconds_bucket[5m])) by (le, horizon))",
          "legendFormat": "p95 {{horizon}}", "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(aureus_analysis_duration_seconds_bucket[5m])) by (le, horizon))",
          "legendFormat": "p99 {{horizon}}", "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      }
    },

    {
      "id": 3,
      "title": "LLM API Call Rate by Agent",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(aureus_llm_calls_total[5m])) by (agent, status)",
          "legendFormat": "{{agent}} / {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 5 } }
      }
    },

    {
      "id": 4,
      "title": "LLM Call Duration p95 by Agent",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(aureus_llm_call_duration_seconds_bucket[5m])) by (le, agent))",
          "legendFormat": "p95 {{agent}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } }
      }
    },

    {
      "id": 5,
      "title": "Provider Rate Limit Hits",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(aureus_provider_rate_limit_hits_total[5m])) by (provider)",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "fixedColor": "orange", "mode": "fixed" },
          "custom": { "lineWidth": 2 }
        }
      }
    },

    {
      "id": 6,
      "title": "Execution Orders by Status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(aureus_execution_orders_total[5m])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      }
    },

    {
      "id": 7,
      "title": "Active WebSocket Connections",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 16 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "aureus_ws_connections", "legendFormat": "connections", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },

    {
      "id": 8,
      "title": "Redis Stream Depths",
      "type": "bargauge",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 20 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "aureus_stream_depth",
          "legendFormat": "{{stream}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 1000 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal" }
    },

    {
      "id": 9,
      "title": "Successful Analysis Requests (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 24 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "increase(aureus_analysis_requests_total{status='complete'}[24h])", "legendFormat": "", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "fixedColor": "green", "mode": "fixed" } }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" }
    },

    {
      "id": 10,
      "title": "Failed Analysis Requests (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 24 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "increase(aureus_analysis_requests_total{status='failed'}[24h])", "legendFormat": "", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "fixedColor": "red", "mode": "fixed" } }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" }
    },

    {
      "id": 11,
      "title": "Total LLM Calls (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 24 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "increase(aureus_llm_calls_total[24h])", "legendFormat": "", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "fixedColor": "purple", "mode": "fixed" } }
      },
      "options": { "reduceOptions": { "calcs": ["sum"] }, "colorMode": "value", "graphMode": "none" }
    },

    {
      "id": 12,
      "title": "Execution Orders Submitted (24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 24 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "increase(aureus_execution_orders_total{status='submitted'}[24h])", "legendFormat": "", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "fixedColor": "gold", "mode": "fixed" } }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" }
    }

  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["aureus", "fintech", "production"],
  "templating": { "list": [] },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Aureus Intelligence — Operations",
  "uid": "aureus-ops-v1",
  "version": 1
}
