# backend/.env.example
# ---------------------------------------------------------------------
# Copy to backend/.env and fill in real values. backend/.env is
# gitignored and must never be committed.
#
# Every key below is optional unless marked REQUIRED — the app degrades
# rather than failing when a provider is absent (see the fallback chains
# in app/ingestion/market_data.py and app/analysis/llm_provider.py).
# ---------------------------------------------------------------------

# ── PostgreSQL / Redis (REQUIRED — defaults match docker-compose) ─────
DATABASE_URL=postgresql://aureus:localdevpassword@db:5432/aureus_dev
REDIS_URL=redis://redis:6379/0

# ── Market data (fallback order: Polygon → Alpha Vantage → YFinance) ──
# YFinance is the final free fallback and needs no key, so the app works
# with both of these blank.
POLYGON_API_KEY=
ALPHA_VANTAGE_API_KEY=

# ── Fundamentals ──────────────────────────────────────────────────────
# Finnhub free tier: https://finnhub.io/register
FINNHUB_API_KEY=

# SEC EDGAR is public and needs no key, but their fair-access policy
# requires a User-Agent naming you and a REACHABLE contact address, in
# the form "Some Name you@example.com". A malformed value (or a
# placeholder domain) is rejected by app/sentiment/edgar_mdna.py and
# logged, because SEC answers a bad agent with a 403 that looks exactly
# like "this company has no filings".
SEC_EDGAR_USER_AGENT="Your Name you@example.com"

# ── LLM (all optional; the app is deterministic-first) ────────────────
# Cost order at call time: Ollama → OpenAI → Anthropic → none.
# Ollama is free and local — see dev.sh and app/analysis/llm_provider.py.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Sentiment pillar ──────────────────────────────────────────────────
# "lexicon" (default, zero dependencies) or "finbert" (needs
# transformers+torch installed; pulls ~440MB on first use).
SENTIMENT_MODEL=lexicon
SENTIMENT_NEWS_LOOKBACK_DAYS=7
SENTIMENT_PREFILTER_THRESHOLD=0.05

# ── Application ───────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
# Generate with: openssl rand -hex 32
SECRET_KEY=

# ── Stripe (billing) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Internal service auth ─────────────────────────────────────────────
# Shared secret for frontend→backend privileged calls. MUST be identical
# to INTERNAL_API_SECRET in frontend/.env.local.
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# ── Streaming / worker tuning ─────────────────────────────────────────
NEWS_POLL_INTERVAL_SECONDS=60
AGENT_LLM_CALLS_PER_MINUTE=20

# ── Monitoring ────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=
