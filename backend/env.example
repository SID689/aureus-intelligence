# ── PostgreSQL ────────────────────────────────────────────────
DATABASE_URL=postgresql://aureus:localdevpassword@db:5432/aureus_dev

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Market data providers (fallback order: Polygon → Alpha Vantage → YFinance) ──
POLYGON_API_KEY=your_polygon_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
# YFinance requires no key — it is the final free fallback

# ── Fundamental data providers ────────────────────────────────
FINNHUB_API_KEY=your_finnhub_key_here
# SEC EDGAR is public and requires no key, but set a descriptive User-Agent:
SEC_EDGAR_USER_AGENT="AureusIntelligence contact@yourdomain.com"

# ── Application ───────────────────────────────────────────────
APP_ENV=development        # development | staging | production
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_long_random_string_in_production

# ── Stripe (used by Phase 1 middleware, referenced here for completeness) ──
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
