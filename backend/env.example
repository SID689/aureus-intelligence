# ── PostgreSQL ────────────────────────────────────────────────
DATABASE_URL=postgresql://aureus:localdevpassword@db:5432/aureus_dev

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Market data providers ─────────────────────────────────────
POLYGON_API_KEY=your_polygon_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# ── Fundamental + News data ───────────────────────────────────
FINNHUB_API_KEY=your_finnhub_key_here
SEC_EDGAR_USER_AGENT="AureusIntelligence contact@yourdomain.com"

# ── Phase 3: LLM backbone ─────────────────────────────────────
# Required for the multi-agent pipeline to run.
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Application ───────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_long_random_string_in_production

# ── Stripe ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Phase 3: Streaming config ─────────────────────────────────
NEWS_POLL_INTERVAL_SECONDS=60
SENTIMENT_PREFILTER_THRESHOLD=0.05
AGENT_LLM_CALLS_PER_MINUTE=20
